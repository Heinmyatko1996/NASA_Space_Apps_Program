<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'dark',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--floating">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @!themeToggle()
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
